function ensure_audio(): void {
    if (!audio_ready) {
        audio_ready = audio_init(48000, 2, 2048);
    }
}

function tone_sample(phase: i32, period: i32, amplitude: f32): f32 {
    if (period <= 1) {
        return 0.0;
    }
    if ((phase % period) < period / 2) {
        return amplitude;
    }
    return -amplitude;
}

function voice_gain(): f32 {
    return i32_to_f32(game.voice_volume) / 100.0;
}

function release_prompt_audio(): void {
    if (prompt_audio_voice > 0) {
        audio_stop(prompt_audio_voice);
        prompt_audio_voice = 0;
    }
    let i: i32 = 0;
    for (i = 0; i < 3; i = i + 1) {
        if (prompt_audio_assets[i] > 0) {
            audio_release(prompt_audio_assets[i]);
            prompt_audio_assets[i] = 0;
        }
    }
}

function load_prompt_audio(): void {
    release_prompt_audio();
    if (!audio_ready) {
        return;
    }
    prompt_audio_assets[GOAL_COLOR] = audio_load_effect("assets/audio/match-by-color.mp3");
    prompt_audio_assets[GOAL_SHAPE] = audio_load_effect("assets/audio/match-by-shape.mp3");
    prompt_audio_assets[GOAL_NUMBER] = audio_load_effect("assets/audio/match-by-number.mp3");
}

function play_prompt_audio(): void {
    if (prompt_audio_voice > 0) {
        audio_stop(prompt_audio_voice);
        prompt_audio_voice = 0;
    }
    let goal: i32 = current_goal();
    if (!audio_ready || game.voice_volume <= 0 || goal < GOAL_COLOR || goal > GOAL_NUMBER) {
        return;
    }
    if (prompt_audio_assets[goal] > 0) {
        prompt_audio_voice = audio_play(prompt_audio_assets[goal], false, voice_gain(), 0.0);
    }
}

function synchronize_prompt_volume(): void {
    if (prompt_audio_voice > 0) {
        if (audio_voice_is_playing(prompt_audio_voice)) {
            audio_voice_set_volume_pan(prompt_audio_voice, voice_gain(), 0.0);
        } else {
            prompt_audio_voice = 0;
        }
    }
}

function present_audio_event(): void {
    if (presented_audio_revision == game.audio_event_revision) {
        return;
    }
    ensure_audio();
    presented_audio_revision = game.audio_event_revision;
    if (!audio_ready) {
        return;
    }
    if (game.audio_event == AUDIO_PROMPT) {
        play_prompt_audio();
        return;
    }
    let i: i32 = 0;
    for (i = 0; i < 2048; i = i + 1) {
        let envelope: f32 = i32_to_f32(2048 - i) / 2048.0;
        let sample: f32 = 0.0;
        if (game.audio_event == AUDIO_CORRECT) {
            sample = tone_sample(i, 80, 0.10) * envelope;
        } else if (game.audio_event == AUDIO_WRONG) {
            sample = tone_sample(i, 240, 0.055) * envelope;
        } else if (game.audio_event == AUDIO_WIN) {
            if (i < 682) {
                sample = tone_sample(i, 92, 0.08);
            } else if (i < 1365) {
                sample = tone_sample(i, 73, 0.08);
            } else {
                sample = tone_sample(i, 61, 0.08);
            }
            sample = sample * envelope;
        }
        audio_samples[i * 2] = sample;
        audio_samples[i * 2 + 1] = sample;
    }
    audio_push_f32_interleaved(audio_samples, 2048);
}

function main(): i32 {
    reset_game(395);
    init_window(LOGICAL_WIDTH, LOGICAL_HEIGHT, "Toddler Match");
    ui_font = load_font("assets/fonts/Basic-Regular.ttf", 48);
    load_assets();
    audio_ready = false;
    presented_audio_revision = 0;
    prompt_audio_voice = 0;
    ensure_audio();
    load_prompt_audio();
    set_voice_volume(storage_load_i32("toddler_match", "voice_volume", 80));
    return 0;
}

function settings_volume_from_pointer(px: f32): i32 {
    let relative: f32 = px - 170.0;
    if (relative <= 0.0) {
        return 0;
    }
    if (relative >= 560.0) {
        return 100;
    }
    return f32_to_i32(relative * 100.0 / 560.0);
}

function handle_pointer(px: f32, py: f32): void {
    game.pointer_consumed_count = game.pointer_consumed_count + 1;
    ensure_audio();
    if (game.settings_open) {
        if (point_in_rect(px, py, 150.0, 940.0, 600.0, 180.0)) {
            set_voice_volume(settings_volume_from_pointer(px));
            storage_save_i32("toddler_match", "voice_volume", game.voice_volume);
            synchronize_prompt_volume();
        } else if (point_in_rect(px, py, 220.0, 1240.0, 460.0, 150.0)) {
            close_settings();
        }
        return;
    }
    if (point_in_rect(px, py, 730.0, 40.0, 130.0, 130.0)) {
        open_settings();
        return;
    }
    if (game.screen == SCREEN_LEVELS) {
        let level: i32 = 0;
        for (level = 1; level <= 4; level = level + 1) {
            if (point_in_rect(px, py, 80.0, 500.0 + i32_to_f32(level - 1) * 310.0, 740.0, 250.0)) {
                start_level(level);
                return;
            }
        }
        return;
    }
    if (point_in_rect(px, py, 190.0, 680.0, 520.0, 180.0)) {
        replay_prompt();
        return;
    }
    let selected: i32 = option_at(px, py);
    if (selected >= 0) {
        choose_option(selected);
    }
}

function @effects(game, audio, storage, audio_ready, presented_audio_revision, audio_samples, prompt_audio_voice) tick(): i32 {
    if (input_pointer_count() > 0 && input_pointer_went_up(0)) {
        handle_pointer(input_pointer_x_logical(0), input_pointer_y_logical(0));
    }
    advance_game_tick();
    present_audio_event();
    synchronize_prompt_volume();
    return 0;
}

function draw_text(font: i32, text: string, x: f32, y: f32, r: f32, g: f32, b: f32, a: f32): void {
    gfx_cmd_text(font, text, x, y, r, g, b, a);
}

function number_text(value: i32): string {
    if (value == 0) {
        return "0";
    }
    if (value == 1) {
        return "1";
    }
    if (value == 2) {
        return "2";
    }
    if (value == 3) {
        return "3";
    }
    if (value == 4) {
        return "4";
    }
    if (value == 5) {
        return "5";
    }
    if (value == 6) {
        return "6";
    }
    if (value == 7) {
        return "7";
    }
    if (value == 8) {
        return "8";
    }
    if (value == 9) {
        return "9";
    }
    if (value == 10) {
        return "10";
    }
    if (value == 11) {
        return "11";
    }
    if (value == 12) {
        return "12";
    }
    if (value == 13) {
        return "13";
    }
    if (value == 14) {
        return "14";
    }
    return "15";
}

function draw_card(number: i32, shape: i32, color: i32, x: f32, y: f32, w: f32, h: f32, alpha: f32): void {
    fill_rect(x + 8.0, y + 12.0, w, h, 0.78, 0.82, 0.85, alpha);
    fill_rect(x, y, w, h, 1.0, 1.0, 1.0, alpha);
    let size: f32 = 0.0;
    if (game.option_count == 9) {
        size = 116.0;
    } else {
        size = 150.0;
    }
    let sx: f32 = x +(w - size) * 0.5;
    let sy: f32 = y + h - size - 24.0;
    if (shape >= 0 && shape < 6 && color >= 0 && color < 5) {
        gfx_cmd_sprite(sprites[asset_index(shape, color)].handle, sx, sy, size, size, 0, f32_to_i32(alpha * 255.0));
    }
    if (number < 10) {
        draw_text(ui_font, number_text(number), x + w * 0.43, y + 34.0, 0.15, 0.20, 0.22, alpha);
    } else {
        draw_text(ui_font, number_text(number), x + w * 0.34, y + 34.0, 0.15, 0.20, 0.22, alpha);
    }
}

function draw_levels(): void {
    draw_text(ui_font, "TODDLER MATCH", 245.0, 230.0, 0.15, 0.20, 0.22, 1.0);
    draw_text(ui_font, "CHOOSE A LEVEL", 270.0, 330.0, 0.27, 0.35, 0.39, 1.0);
    let level: i32 = 1;
    for (level = 1; level <= 4; level = level + 1) {
        let y: f32 = 500.0 + i32_to_f32(level - 1) * 310.0;
        fill_rect(88.0, y + 12.0, 740.0, 250.0, 0.78, 0.82, 0.85, 1.0);
        fill_rect(80.0, y, 740.0, 250.0, 1.0, 1.0, 1.0, 1.0);
        draw_text(ui_font, "LEVEL", 130.0, y + 42.0, 0.15, 0.20, 0.22, 1.0);
        draw_text(ui_font, number_text(level), 310.0, y + 42.0, 0.15, 0.20, 0.22, 1.0);
        if (level == 1) {
            draw_text(ui_font, "START HERE", 130.0, y + 120.0, 0.13, 0.42, 0.63, 1.0);
        } else if (level == 2) {
            draw_text(ui_font, "SHUFFLE MISTAKES", 130.0, y + 120.0, 0.13, 0.42, 0.63, 1.0);
        } else if (level == 3) {
            draw_text(ui_font, "EXTRA OPTIONS", 130.0, y + 120.0, 0.13, 0.42, 0.63, 1.0);
        } else {
            draw_text(ui_font, "NINE CHOICES", 130.0, y + 120.0, 0.13, 0.42, 0.63, 1.0);
        }
    }
}

function draw_gear(): void {
    fill_rect(730.0, 40.0, 130.0, 130.0, 1.0, 1.0, 1.0, 1.0);
    gfx_cmd_sprite(sprites[33].handle, 745.0, 55.0, 100.0, 100.0, 0, 255);
}

function draw_voice_percentage(): void {
    if (game.voice_volume == 100) {
        draw_text(ui_font, "100", 595.0, 760.0, 0.15, 0.20, 0.22, 1.0);
    } else if (game.voice_volume >= 10) {
        draw_text(ui_font, number_text(game.voice_volume / 10), 620.0, 760.0, 0.15, 0.20, 0.22, 1.0);
        draw_text(ui_font, number_text(game.voice_volume % 10), 645.0, 760.0, 0.15, 0.20, 0.22, 1.0);
    } else {
        draw_text(ui_font, number_text(game.voice_volume), 645.0, 760.0, 0.15, 0.20, 0.22, 1.0);
    }
    draw_text(ui_font, "%", 680.0, 760.0, 0.15, 0.20, 0.22, 1.0);
}

function draw_settings(): void {
    fill_rect(0.0, 0.0, 900.0, 2000.0, 0.05, 0.07, 0.09, 0.72);
    fill_rect(108.0, 512.0, 700.0, 900.0, 0.08, 0.11, 0.13, 0.32);
    fill_rect(100.0, 500.0, 700.0, 900.0, 1.0, 1.0, 1.0, 1.0);
    draw_text(ui_font, "SETTINGS", 310.0, 590.0, 0.15, 0.20, 0.22, 1.0);
    draw_text(ui_font, "VOICE OVER", 170.0, 760.0, 0.13, 0.42, 0.63, 1.0);
    draw_voice_percentage();
    fill_rect(170.0, 1005.0, 560.0, 50.0, 0.78, 0.82, 0.85, 1.0);
    let filled: f32 = 560.0 * i32_to_f32(game.voice_volume) / 100.0;
    fill_rect(170.0, 1005.0, filled, 50.0, 0.13, 0.42, 0.63, 1.0);
    let knob_x: f32 = 170.0 + filled - 28.0;
    if (knob_x < 142.0) {
        knob_x = 142.0;
    }
    if (knob_x > 702.0) {
        knob_x = 702.0;
    }
    fill_rect(knob_x, 980.0, 56.0, 100.0, 0.15, 0.20, 0.22, 1.0);
    fill_rect(228.0, 1252.0, 460.0, 150.0, 0.09, 0.29, 0.42, 1.0);
    fill_rect(220.0, 1240.0, 460.0, 150.0, 0.13, 0.42, 0.63, 1.0);
    draw_text(ui_font, "DONE", 385.0, 1282.0, 1.0, 1.0, 1.0, 1.0);
}

function draw_play(): void {
    draw_text(ui_font, "LEVEL", 60.0, 58.0, 0.15, 0.20, 0.22, 1.0);
    draw_text(ui_font, number_text(game.level), 240.0, 58.0, 0.15, 0.20, 0.22, 1.0);
    let prompt_alpha: f32 = 1.0;
    if (game.phase == PHASE_WON) {
        prompt_alpha = 0.15;
    } else if (game.phase == PHASE_PROMPT_FADE) {
        prompt_alpha = i32_to_f32(game.phase_ticks) / i32_to_f32(PROMPT_FADE_TICKS);
    }
    draw_card(game.target.number, game.target.shape, game.target.color, 330.0, 230.0, 240.0, 330.0, prompt_alpha);
    fill_rect(190.0, 680.0, 520.0, 180.0, 1.0, 1.0, 1.0, prompt_alpha);
    gfx_cmd_sprite(sprites[30 + current_goal()].handle, 225.0, 720.0, 100.0, 100.0, 0, f32_to_i32(prompt_alpha * 255.0));
    if (current_goal() == GOAL_COLOR) {
        draw_text(ui_font, "MATCH BY COLOR", 335.0, 735.0, 0.15, 0.20, 0.22, prompt_alpha);
    } else if (current_goal() == GOAL_SHAPE) {
        draw_text(ui_font, "MATCH BY SHAPE", 335.0, 735.0, 0.15, 0.20, 0.22, prompt_alpha);
    } else {
        draw_text(ui_font, "MATCH BY NUMBER", 320.0, 735.0, 0.15, 0.20, 0.22, prompt_alpha);
    }
    let i: i32 = 0;
    for (i = 0; i < game.option_count; i = i + 1) {
        let alpha: f32 = 1.0;
        if (game.options[i].matched) {
            alpha = 0.18;
        }
        if (game.phase == PHASE_WON) {
            let delay: i32 = i * 5;
            if (game.phase_ticks > delay) {
                alpha = 1.0 - i32_to_f32(game.phase_ticks - delay) / 100.0;
            }
            if (alpha < 0.0) {
                alpha = 0.0;
            }
        }
        let x: f32 = option_x(i);
        if (game.shake_index == i && game.shake_ticks > 0) {
            if ((game.shake_ticks % 4) < 2) {
                x = x + 18.0;
            } else {
                x = x - 18.0;
            }
        }
        draw_card(
            game.options[i].number,
            game.options[i].shape,
            game.options[i].color,
            x,
            option_y(i),
            option_w(),
            option_h(),
            alpha
        );
    }
    if (game.phase == PHASE_WON) {
        draw_text(ui_font, "GREAT JOB!", 310.0, 1820.0, 0.12, 0.55, 0.25, 1.0);
        draw_text(ui_font, "NEXT SOON", 330.0, 1890.0, 0.27, 0.35, 0.39, 1.0);
    }
}

function @effects(graphics, memory) render(): i32 {
    begin_frame();
    clear(0.94, 0.96, 0.97, 1.0);
    if (game.screen == SCREEN_LEVELS) {
        draw_levels();
    } else {
        draw_play();
    }
    draw_gear();
    if (game.settings_open) {
        draw_settings();
    }
    end_frame();
    return 0;
}

function on_code_swap(): void {
    load_assets();
    load_prompt_audio();
    set_voice_volume(game.voice_volume);
}
