function ensure_audio(): void {
    if (!audio_ready) {
        audio_ready = audio_init(48000, 2, 2048);
        if (audio_ready && !prompt_audio_loaded) {
            load_prompt_audio();
        }
    }
}

function tone_sample(phase: i32, period: i32, amplitude: f32): f32 {
    if (period <= 1) {
        return 0.0;
    }
    if ((phase % period) < period / 2) {
        return amplitude;
    }
    return -amplitude;
}

function voice_gain(): f32 {
    return i32_to_f32(game.voice_volume) / 100.0;
}

function release_prompt_audio(): void {
    if (prompt_audio_voice > 0) {
        audio_stop(prompt_audio_voice);
        prompt_audio_voice = 0;
    }
    let i: i32 = 0;
    for (i = 0; i < 3; i = i + 1) {
        prompt_audio_assets[i].release();
    }
    prompt_audio_loaded = false;
}

function load_prompt_audio(): void {
    release_prompt_audio();
    if (!audio_ready) {
        return;
    }
    let color_loaded: bool = prompt_audio_assets[GOAL_COLOR].load_audio("assets/audio/match-by-color.mp3");
    let shape_loaded: bool = prompt_audio_assets[GOAL_SHAPE].load_audio("assets/audio/match-by-shape.mp3");
    let number_loaded: bool = prompt_audio_assets[GOAL_NUMBER].load_audio("assets/audio/match-by-number.mp3");
    prompt_audio_loaded = color_loaded && shape_loaded && number_loaded;
}

function play_prompt_audio(): bool {
    if (prompt_audio_voice > 0) {
        audio_stop(prompt_audio_voice);
        prompt_audio_voice = 0;
    }
    let goal: i32 = current_goal();
    if (game.voice_volume <= 0 || goal < GOAL_COLOR || goal > GOAL_NUMBER) {
        return true;
    }
    if (!audio_ready || !prompt_audio_assets[goal].ready()) {
        return false;
    }
    prompt_audio_voice = audio_play(prompt_audio_assets[goal].handle, false, voice_gain(), 0.0);
    return prompt_audio_voice > 0;
}

function synchronize_prompt_volume(): void {
    if (prompt_audio_voice > 0) {
        if (audio_voice_is_playing(prompt_audio_voice)) {
            audio_voice_set_volume_pan(prompt_audio_voice, voice_gain(), 0.0);
        } else {
            prompt_audio_voice = 0;
        }
    }
}

function present_audio_event(): void {
    if (presented_audio_revision == game.audio_event_revision) {
        return;
    }
    ensure_audio();
    if (game.audio_event == AUDIO_PROMPT) {
        if (play_prompt_audio()) {
            presented_audio_revision = game.audio_event_revision;
        }
        return;
    }
    presented_audio_revision = game.audio_event_revision;
    if (!audio_ready) {
        return;
    }
    let i: i32 = 0;
    for (i = 0; i < 2048; i = i + 1) {
        let envelope: f32 = i32_to_f32(2048 - i) / 2048.0;
        let sample: f32 = 0.0;
        if (game.audio_event == AUDIO_CORRECT) {
            sample = tone_sample(i, 80, 0.10) * envelope;
        } else if (game.audio_event == AUDIO_WRONG) {
            sample = tone_sample(i, 240, 0.055) * envelope;
        } else if (game.audio_event == AUDIO_WIN) {
            if (i < 682) {
                sample = tone_sample(i, 92, 0.08);
            } else if (i < 1365) {
                sample = tone_sample(i, 73, 0.08);
            } else {
                sample = tone_sample(i, 61, 0.08);
            }
            sample = sample * envelope;
        }
        audio_samples[i * 2] = sample;
        audio_samples[i * 2 + 1] = sample;
    }
    audio_push_f32_interleaved(audio_samples, 2048);
}

function main(): i32 {
    reset_game(395);
    init_window(LOGICAL_WIDTH, LOGICAL_HEIGHT, "Toddler Match");
    ui_font = load_font("assets/fonts/Basic-Regular.ttf", 48);
    load_assets();
    audio_ready = false;
    prompt_audio_loaded = false;
    presented_audio_revision = 0;
    prompt_audio_voice = 0;
    ensure_audio();
    set_voice_volume(storage_load_i32("toddler_match", "voice_volume", 80));
    return 0;
}

function settings_volume_from_pointer(px: f32): i32 {
    let relative: f32 = px - 170.0;
    if (relative <= 0.0) {
        return 0;
    }
    if (relative >= 560.0) {
        return 100;
    }
    return f32_to_i32(relative * 100.0 / 560.0);
}

function handle_pointer(px: f32, py: f32): void {
    game.pointer_consumed_count = game.pointer_consumed_count + 1;
    ensure_audio();
    if (game.settings_open) {
        if (point_in_rect(px, py, 150.0, 940.0, 600.0, 180.0)) {
            set_voice_volume(settings_volume_from_pointer(px));
            storage_save_i32("toddler_match", "voice_volume", game.voice_volume);
            synchronize_prompt_volume();
        } else if (point_in_rect(px, py, 220.0, 1240.0, 460.0, 150.0)) {
            close_settings();
        }
        return;
    }
    if (point_in_rect(px, py, 730.0, 40.0, 130.0, 130.0)) {
        open_settings();
        return;
    }
    if (game.screen == SCREEN_LEVELS) {
        let level: i32 = 0;
        for (level = 1; level <= 4; level = level + 1) {
            if (point_in_rect(px, py, 80.0, 500.0 + i32_to_f32(level - 1) * 310.0, 740.0, 250.0)) {
                start_level(level);
                return;
            }
        }
        return;
    }
    if (point_in_rect(px, py, 190.0, 680.0, 520.0, 180.0)) {
        replay_prompt();
        return;
    }
    let selected: i32 = option_at(px, py);
    if (selected >= 0) {
        choose_option(selected);
    }
}

function tick(): i32 {
    host_frame.refresh(frame);
    if (frame.pointer_count > 0 && frame.pointers[0].went_up) {
        handle_pointer(frame.pointers[0].x_logical, frame.pointers[0].y_logical);
    }
    advance_game_tick();
    present_audio_event();
    synchronize_prompt_volume();
    return 0;
}

function draw_text(run_index: i32, x: f32, y: f32, r: f32, g: f32, b: f32, a: f32): void {
    if (run_index < 0 || run_index >= TEXT_RUN_COUNT) {
        return;
    }
    text_runs[run_index].draw(x, y, r, g, b, a);
}

function draw_card(number: i32, shape: i32, color: i32, x: f32, y: f32, w: f32, h: f32, alpha: f32): void {
    fill_rect(x + 8.0, y + 12.0, w, h, 0.78, 0.82, 0.85, alpha);
    fill_rect(x, y, w, h, 1.0, 1.0, 1.0, alpha);
    let size: f32 = 0.0;
    if (game.option_count == 9) {
        size = 116.0;
    } else {
        size = 150.0;
    }
    let sx: f32 = ui_place_x(x, w, size, UiHorizontal.Center);
    let sy: f32 = ui_place_y(y, h, size, UiVertical.Center);
    if (shape >= 0 && shape < 6 && color >= 0 && color < 5) {
        draw_sprite(sprites[asset_index(shape, color)].handle, sx, sy, size, size, 0, f32_to_i32(alpha * 255.0));
    }
    if (number >= 0 && number <= 30) {
        let number_x: f32 = ui_place_x(x, w, text_runs[number].width, UiHorizontal.Center);
        let number_y: f32 = sy - text_runs[number].height - 8.0;
        if (number_y < y + 8.0) {
            number_y = y + 8.0;
        }
        draw_text(number, number_x, number_y, 0.15, 0.20, 0.22, alpha);
    }
}

function draw_levels(): void {
    draw_text(TEXT_TODDLER_MATCH, 245.0, 230.0, 0.15, 0.20, 0.22, 1.0);
    draw_text(TEXT_CHOOSE_LEVEL, 270.0, 330.0, 0.27, 0.35, 0.39, 1.0);
    let level: i32 = 1;
    for (level = 1; level <= 4; level = level + 1) {
        let y: f32 = 500.0 + i32_to_f32(level - 1) * 310.0;
        fill_rect(88.0, y + 12.0, 740.0, 250.0, 0.78, 0.82, 0.85, 1.0);
        fill_rect(80.0, y, 740.0, 250.0, 1.0, 1.0, 1.0, 1.0);
        draw_text(TEXT_LEVEL, 130.0, y + 42.0, 0.15, 0.20, 0.22, 1.0);
        draw_text(level, 310.0, y + 42.0, 0.15, 0.20, 0.22, 1.0);
        if (level == 1) {
            draw_text(TEXT_START_HERE, 130.0, y + 120.0, 0.13, 0.42, 0.63, 1.0);
        } else if (level == 2) {
            draw_text(TEXT_SHUFFLE_MISTAKES, 130.0, y + 120.0, 0.13, 0.42, 0.63, 1.0);
        } else if (level == 3) {
            draw_text(TEXT_EXTRA_OPTIONS, 130.0, y + 120.0, 0.13, 0.42, 0.63, 1.0);
        } else {
            draw_text(TEXT_NINE_CHOICES, 130.0, y + 120.0, 0.13, 0.42, 0.63, 1.0);
        }
    }
}

function draw_settings_button(): void {
    fill_rect(738.0, 48.0, 130.0, 130.0, 0.78, 0.82, 0.85, 1.0);
    fill_rect(730.0, 40.0, 130.0, 130.0, 1.0, 1.0, 1.0, 1.0);
    fill_rect(730.0, 40.0, 10.0, 130.0, 0.13, 0.42, 0.63, 1.0);
    draw_text(TEXT_MENU, 748.0, 82.0, 0.13, 0.42, 0.63, 1.0);
}

function draw_voice_percentage(): void {
    if (game.voice_volume == 100) {
        draw_text(TEXT_HUNDRED, 595.0, 760.0, 0.15, 0.20, 0.22, 1.0);
    } else if (game.voice_volume >= 10) {
        draw_text(game.voice_volume / 10, 620.0, 760.0, 0.15, 0.20, 0.22, 1.0);
        draw_text(game.voice_volume % 10, 645.0, 760.0, 0.15, 0.20, 0.22, 1.0);
    } else {
        draw_text(game.voice_volume, 645.0, 760.0, 0.15, 0.20, 0.22, 1.0);
    }
    draw_text(TEXT_PERCENT, 680.0, 760.0, 0.15, 0.20, 0.22, 1.0);
}

function draw_settings(): void {
    fill_rect(0.0, 0.0, 900.0, 2000.0, 0.05, 0.07, 0.09, 0.72);
    fill_rect(108.0, 512.0, 700.0, 900.0, 0.08, 0.11, 0.13, 0.32);
    fill_rect(100.0, 500.0, 700.0, 900.0, 1.0, 1.0, 1.0, 1.0);
    draw_text(TEXT_SETTINGS, 310.0, 590.0, 0.15, 0.20, 0.22, 1.0);
    draw_text(TEXT_VOICE_OVER, 170.0, 760.0, 0.13, 0.42, 0.63, 1.0);
    draw_voice_percentage();
    fill_rect(170.0, 1005.0, 560.0, 50.0, 0.78, 0.82, 0.85, 1.0);
    let filled: f32 = 560.0 * i32_to_f32(game.voice_volume) / 100.0;
    fill_rect(170.0, 1005.0, filled, 50.0, 0.13, 0.42, 0.63, 1.0);
    let knob_x: f32 = 170.0 + filled - 28.0;
    if (knob_x < 142.0) {
        knob_x = 142.0;
    }
    if (knob_x > 702.0) {
        knob_x = 702.0;
    }
    fill_rect(knob_x, 980.0, 56.0, 100.0, 0.15, 0.20, 0.22, 1.0);
    fill_rect(228.0, 1252.0, 460.0, 150.0, 0.09, 0.29, 0.42, 1.0);
    fill_rect(220.0, 1240.0, 460.0, 150.0, 0.13, 0.42, 0.63, 1.0);
    draw_text(TEXT_DONE, 385.0, 1282.0, 1.0, 1.0, 1.0, 1.0);
}

function draw_play(): void {
    draw_text(TEXT_LEVEL, 60.0, 58.0, 0.15, 0.20, 0.22, 1.0);
    draw_text(game.level, 240.0, 58.0, 0.15, 0.20, 0.22, 1.0);
    let prompt_alpha: f32 = 1.0;
    if (game.phase == PHASE_WON) {
        prompt_alpha = 1.0 - i32_to_f32(game.phase_ticks) / i32_to_f32(PROMPT_FADE_TICKS);
        if (prompt_alpha < 0.0) {
            prompt_alpha = 0.0;
        }
    } else if (game.phase == PHASE_PROMPT_FADE) {
        prompt_alpha = i32_to_f32(game.phase_ticks) / i32_to_f32(PROMPT_FADE_TICKS);
    }
    draw_card(game.target.number, game.target.shape, game.target.color, 330.0, 230.0, 240.0, 330.0, prompt_alpha);
    fill_rect(190.0, 680.0, 520.0, 180.0, 1.0, 1.0, 1.0, prompt_alpha);
    if (current_goal() != GOAL_NUMBER) {
        sprites[30 + current_goal()].draw(225.0, 720.0, f32_to_i32(prompt_alpha * 255.0), 0);
    } else {
        let number_x: f32 = ui_place_x(225.0, 100.0, text_runs[TEXT_PROMPT_NUMBER].width, UiHorizontal.Center);
        let number_y: f32 = ui_place_y(720.0, 100.0, text_runs[TEXT_PROMPT_NUMBER].height, UiVertical.Center);
        draw_text(TEXT_PROMPT_NUMBER, number_x, number_y, 0.15, 0.20, 0.22, prompt_alpha);
    }
    let prompt_label: i32 = TEXT_MATCH_COLOR + current_goal();
    let prompt_label_x: f32 = 335.0;
    if (current_goal() == GOAL_NUMBER) {
        prompt_label_x = 320.0;
    }
    let prompt_label_y: f32 = ui_place_y(680.0, 180.0, text_runs[prompt_label].height, UiVertical.Center);
    draw_text(prompt_label, prompt_label_x, prompt_label_y, 0.15, 0.20, 0.22, prompt_alpha);
    let i: i32 = 0;
    for (i = 0; i < game.option_count; i = i + 1) {
        let alpha: f32 = 1.0;
        if (game.options[i].matched) {
            alpha = 0.18;
        }
        let y: f32 = option_y(i);
        if (game.phase == PHASE_WON) {
            let delay: i32 = i * 5;
            let bounce_ticks: i32 = game.phase_ticks - delay;
            if (bounce_ticks > 0 && bounce_ticks <= 24) {
                y = y - i32_to_f32(bounce_ticks) * 80.0 / 24.0;
            } else if (bounce_ticks > 24 && bounce_ticks < 120) {
                y = y - 80.0 + i32_to_f32(bounce_ticks - 24) * 1680.0 / 96.0;
            } else if (bounce_ticks >= 120) {
                y = y + 1600.0;
            }
        }
        let x: f32 = option_x(i);
        if (game.shake_index == i && game.shake_ticks > 0) {
            if ((game.shake_ticks % 4) < 2) {
                x = x + 18.0;
            } else {
                x = x - 18.0;
            }
        }
        draw_card(game.options[i].number, game.options[i].shape, game.options[i].color, x, y, option_w(), option_h(), alpha);
    }
    if (game.phase == PHASE_WON) {
        draw_text(TEXT_GREAT_JOB, 310.0, 1820.0, 0.12, 0.55, 0.25, 1.0);
        let seconds_left: i32 =(WIN_TICKS - game.phase_ticks + 59) / 60;
        if (seconds_left < 1) {
            seconds_left = 1;
        }
        draw_text(TEXT_NEXT_SOON, 280.0, 1890.0, 0.27, 0.35, 0.39, 1.0);
        draw_text(seconds_left, 545.0, 1890.0, 0.27, 0.35, 0.39, 1.0);
    }
}

function render(): i32 {
    begin_frame();
    clear(0.94, 0.96, 0.97, 1.0);
    if (game.screen == SCREEN_LEVELS) {
        draw_levels();
    } else {
        draw_play();
    }
    draw_settings_button();
    if (game.settings_open) {
        draw_settings();
    }
    end_frame();
    return 0;
}

function on_code_swap(): void {
    load_assets();
    if (audio_ready) {
        load_prompt_audio();
    }
    set_voice_volume(game.voice_volume);
}
