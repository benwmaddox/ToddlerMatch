import "../src/main.stasis";

test `prompt revision remains pending while its asset is loading`(): bool {
    reset_game(395);
    start_level(1);
    audio_ready = true;
    presented_audio_revision = 0;
    let goal: i32 = current_goal();
    prompt_audio_assets[goal].request = 0;
    prompt_audio_assets[goal].state = AssetState.Pending;
    present_audio_event();
    if (presented_audio_revision == game.audio_event_revision) {
        return false;
    }
    set_voice_volume(0);
    present_audio_event();
    return presented_audio_revision == game.audio_event_revision;
}

test `procedural cue revisions commit without audio availability`(): bool {
    reset_game(395);
    audio_ready = false;
    presented_audio_revision = 0;
    emit_audio(AUDIO_CORRECT);
    present_audio_event();
    return presented_audio_revision == game.audio_event_revision;
}

test `menu pointer exits play and commits prompt stop`(): bool {
    reset_game(395);
    start_level(2);
    presented_audio_revision = game.audio_event_revision;
    handle_pointer(795.0, 105.0);
    if (game.screen != SCREEN_LEVELS || game.audio_event != AUDIO_STOP_PROMPT) {
        return false;
    }
    present_audio_event();
    return presented_audio_revision == game.audio_event_revision && prompt_audio_voice == 0;
}

test `help pointer opens help and menu returns to levels`(): bool {
    if (
        !help_menu_link_at(330.0, 390.0)
        || !help_menu_link_at(570.0, 480.0)
        || help_menu_link_at(329.99, 435.0)
        || help_menu_link_at(570.01, 435.0)
        || !maddoxlabs_link_at(150.0, 1470.0)
        || !maddoxlabs_link_at(750.0, 1650.0)
        || maddoxlabs_link_at(149.99, 1560.0)
        || maddoxlabs_link_at(750.01, 1560.0)
    ) {
        return false;
    }
    reset_game(137);
    handle_pointer(450.0, 435.0);
    if (game.screen != SCREEN_HELP) {
        return false;
    }
    handle_pointer(795.0, 105.0);
    return game.screen == SCREEN_LEVELS && game.pointer_consumed_count == 2;
}
