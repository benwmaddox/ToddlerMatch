import "../src/game.stasis";
import "/vendor/stasis/stdlib/ui_axis_layout.stasis";
import "/vendor/stasis/stdlib/testing/ui_layout_audit.stasis";

function find_match(): i32 {
    let i: i32 = 0;
    for (i = 0; i < game.option_count; i = i + 1) {
        if (!game.options[i].matched && option_matches_target(i)) {
            return i;
        }
    }
    return -1;
}

function find_wrong(): i32 {
    let i: i32 = 0;
    for (i = 0; i < game.option_count; i = i + 1) {
        if (!option_matches_target(i)) {
            return i;
        }
    }
    return -1;
}

test `all four levels preserve their bounds and choice counts`(): bool {
    reset_game(395);
    configure_level(1);
    if (game.option_count != 6 || game.max_number != 6 || game.color_count != 4 || game.shape_count != 5 || game.shuffle_on_mistake) {
        return false;
    }
    configure_level(2);
    if (!game.shuffle_on_mistake || game.option_count != 6) {
        return false;
    }
    configure_level(3);
    if (game.max_number != 20 || game.color_count != 5 || game.shape_count != 6 || game.option_count != 6) {
        return false;
    }
    configure_level(4);
    return game.option_count == 9 && game.max_number == 30 && game.shuffle_on_mistake;
}

test `generation is deterministic bounded and guarantees a match`(): bool {
    reset_game(395);
    start_level(4);
    if (find_match() < 0 || game.matches_remaining < 1 || game.matches_remaining > 9) {
        return false;
    }
    let first_number: i32 = game.options[0].number;
    let first_shape: i32 = game.options[0].shape;
    let first_color: i32 = game.options[0].color;
    reset_game(395);
    start_level(4);
    return game.options[0].number == first_number && game.options[0].shape == first_shape && game.options[0].color == first_color;
}

test `generated rounds preserve constraints across levels and rules`(): bool {
    reset_game(395);
    let goals_seen: bool[3];
    let level: i32 = 1;
    for (level = 1; level <= 4; level = level + 1) {
        configure_level(level);
        let iteration: i32 = 0;
        for (iteration = 0; iteration < 32; iteration = iteration + 1) {
            generate_round();
            if (
                game.goal < GOAL_COLOR
                || game.goal > GOAL_NUMBER
                || game.target.number < 1
                || game.target.number > game.max_number
                || game.target.shape < 0
                || game.target.shape >= game.shape_count
                || game.target.color < 0
                || game.target.color >= game.color_count
            ) {
                return false;
            }
            goals_seen[game.goal] = true;
            let matches: i32 = 0;
            let option: i32 = 0;
            for (option = 0; option < game.option_count; option = option + 1) {
                if (
                    game.options[option].number < 1
                    || game.options[option].number > game.max_number
                    || game.options[option].shape < 0
                    || game.options[option].shape >= game.shape_count
                    || game.options[option].color < 0
                    || game.options[option].color >= game.color_count
                ) {
                    return false;
                }
                if (option_matches_target(option)) {
                    matches = matches + 1;
                }
            }
            if (matches < 1 || matches != game.matches_remaining) {
                return false;
            }
        }
    }
    return goals_seen[GOAL_COLOR] && goals_seen[GOAL_SHAPE] && goals_seen[GOAL_NUMBER];
}

test `correct choices retire once and win at zero`(): bool {
    reset_game(91);
    start_level(1);
    let before: i32 = game.matches_remaining;
    let index: i32 = find_match();
    if (index < 0 || !choose_option(index) || game.matches_remaining != before - 1) {
        return false;
    }
    if (choose_option(index)) {
        return false;
    }
    let guard: i32 = 0;
    for (guard = 0; guard < 9 && game.phase == PHASE_ACTIVE; guard = guard + 1) {
        index = find_match();
        if (index >= 0) {
            choose_option(index);
        }
    }
    return game.phase == PHASE_WON && game.matches_remaining == 0 && game.audio_event == AUDIO_WIN;
}

test `level one shakes and later levels shuffle on mistakes`(): bool {
    reset_game(17);
    start_level(1);
    let wrong: i32 = find_wrong();
    if (wrong < 0) {
        return false;
    }
    choose_option(wrong);
    if (game.shake_index != wrong || game.shake_ticks != SHAKE_TICKS || game.shuffle_revision != 0) {
        return false;
    }
    reset_game(17);
    start_level(2);
    wrong = find_wrong();
    if (wrong < 0) {
        return false;
    }
    choose_option(wrong);
    return game.shake_index == -1 && game.shuffle_revision == 1 && game.audio_event == AUDIO_WRONG;
}

test `later-level shuffle always changes remaining card order`(): bool {
    reset_game(2);
    game.option_count = 2;
    game.options[0].number = 1;
    game.options[0].shape = 0;
    game.options[0].color = 0;
    game.options[0].matched = false;
    game.options[1].number = 2;
    game.options[1].shape = 1;
    game.options[1].color = 1;
    game.options[1].matched = false;
    shuffle_unmatched();
    return game.options[0].number == 2 && game.options[1].number == 1 && game.shuffle_revision == 1;
}

test `prompt replay is active-only and reset-safe`(): bool {
    reset_game(31);
    start_level(3);
    replay_prompt();
    if (game.prompt_replays != 1 || game.audio_event != AUDIO_PROMPT) {
        return false;
    }
    game.phase = PHASE_WON;
    replay_prompt();
    if (game.prompt_replays != 1) {
        return false;
    }
    reset_game(31);
    return game.prompt_replays == 0 && game.audio_event == AUDIO_NONE;
}

test `win and prompt transitions use exact toddler pacing`(): bool {
    reset_game(53);
    start_level(1);
    game.phase = PHASE_WON;
    game.phase_ticks = WIN_TICKS - 1;
    advance_game_tick();
    if (game.phase != PHASE_PROMPT_FADE || game.phase_ticks != 0) {
        return false;
    }
    game.phase_ticks = PROMPT_FADE_TICKS - 1;
    advance_game_tick();
    return game.phase == PHASE_ACTIVE && game.phase_ticks == 0;
}

test `logical pointer boundaries and round trips are exact`(): bool {
    if (!point_in_rect(54.0, 1030.0, 54.0, 1030.0, 240.0, 320.0)) {
        return false;
    }
    if (!point_in_rect(294.0, 1350.0, 54.0, 1030.0, 240.0, 320.0)) {
        return false;
    }
    if (point_in_rect(294.01, 1350.0, 54.0, 1030.0, 240.0, 320.0)) {
        return false;
    }
    let x: f32 = 417.0;
    let px: f32 = logical_to_viewport_axis(x, 1440.0, i32_to_f32(LOGICAL_WIDTH));
    let round_trip: f32 = map_pointer_axis(px, 1440.0, i32_to_f32(LOGICAL_WIDTH));
    return round_trip == x && map_pointer_axis(-1.0, 1440.0, 900.0) == 0.0 && map_pointer_axis(1441.0, 1440.0, 900.0) == 900.0;
}

test `shared axis placement centers shape art in every card layout`(): bool {
    let target_x: f32 = ui_place_x(330.0, 240.0, 150.0, UiHorizontal.Center);
    let target_y: f32 = ui_place_y(230.0, 330.0, 150.0, UiVertical.Center);
    if (!ui_audit_centered_x(330.0, 240.0, target_x, 150.0, 0.0) || !ui_audit_centered_y(230.0, 330.0, target_y, 150.0, 0.0)) {
        return false;
    }

    let option_x: f32 = ui_place_x(54.0, 240.0, 150.0, UiHorizontal.Center);
    let option_y: f32 = ui_place_y(1030.0, 320.0, 150.0, UiVertical.Center);
    if (!ui_audit_centered_x(54.0, 240.0, option_x, 150.0, 0.0) || !ui_audit_centered_y(1030.0, 320.0, option_y, 150.0, 0.0)) {
        return false;
    }

    let compact_x: f32 = ui_place_x(54.0, 240.0, 116.0, UiHorizontal.Center);
    let compact_y: f32 = ui_place_y(960.0, 250.0, 116.0, UiVertical.Center);
    return ui_audit_centered_x(54.0, 240.0, compact_x, 116.0, 0.0) && ui_audit_centered_y(960.0, 250.0, compact_y, 116.0, 0.0);
}

test `orientation recreation keeps authoritative state`(): bool {
    reset_game(73);
    start_level(4);
    let rng_before: i32 = game.rng_state;
    let rounds_before: i32 = game.rounds_completed;
    let x_portrait: f32 = map_pointer_axis(450.0, 900.0, 900.0);
    let x_landscape: f32 = map_pointer_axis(1000.0, 2000.0, 900.0);
    return x_portrait == x_landscape && game.rng_state == rng_before && game.rounds_completed == rounds_before;
}

test `state and caches remain bounded`(): bool {
    reset_game(101);
    start_level(4);
    let i: i32 = 0;
    for (i = 0; i < 1000; i = i + 1) {
        advance_game_tick();
    }
    return game.option_count <= MAX_OPTIONS && game.shake_ticks >= 0 && game.audio_event_revision >= 1 && game.pointer_consumed_count == 0;
}

test `voice volume clamps both endpoints`(): bool {
    reset_game(107);
    if (game.voice_volume != 80 || clamp_voice_volume(-1) != 0 || clamp_voice_volume(101) != 100) {
        return false;
    }
    set_voice_volume(-20);
    if (game.voice_volume != 0) {
        return false;
    }
    set_voice_volume(140);
    return game.voice_volume == 100;
}

test `settings freeze ticks and block prompt actions`(): bool {
    reset_game(109);
    start_level(2);
    game.phase = PHASE_WON;
    game.phase_ticks = WIN_TICKS - 1;
    let tick_before: i32 = game.tick_count;
    let audio_before: i32 = game.audio_event_revision;
    open_settings();
    advance_game_tick();
    replay_prompt();
    if (!game.settings_open || game.tick_count != tick_before || game.phase_ticks != WIN_TICKS - 1 || game.audio_event_revision != audio_before) {
        return false;
    }
    close_settings();
    advance_game_tick();
    return !game.settings_open && game.phase == PHASE_PROMPT_FADE && game.tick_count == tick_before + 1;
}
